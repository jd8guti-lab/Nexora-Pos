# Copia este archivo a .env.local y llena los valores.
# .env* está en .gitignore: NADA de esto se sube al repositorio.

# --- Supabase -----------------------------------------------------------------
# Settings → API en el proyecto de Supabase.

# La URL del proyecto. Se ve así: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# La llave ANÓNIMA (anon / public).
#
# Es pública POR DISEÑO: viaja dentro del JavaScript que baja el navegador, y no hay forma de
# esconderla. Lo que impide que una empresa lea los datos de otra son las políticas RLS del esquema
# de cada aplicación, no el secreto de esta llave. Ver backend/README.md.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LO QUE NUNCA VA AQUÍ -----------------------------------------------------
#
# La llave `service_role` se salta TODAS las políticas RLS: con ella se leen y se borran los datos
# de todas las empresas. No va en este archivo, ni en Vercel, ni en ninguna variable que empiece
# por NEXT_PUBLIC_ (todo lo NEXT_PUBLIC_ termina dentro del bundle del navegador).
#
# Solo se usa a mano, en tu máquina, para crear usuarios. Ver docs/PUESTA-EN-MARCHA-SUPABASE.md.

# --- Sitio --------------------------------------------------------------------

# El dominio real, para las canónicas, el sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=

# A dónde apunta "Acceso clientes" en el nav. Por defecto /portal, aquí mismo.
NEXT_PUBLIC_PORTAL_URL=

# --- Google -------------------------------------------------------------------
#
# Las dos son opcionales y el sitio funciona sin ellas. Las lee lib/config.ts.

# El token de verificación de Google Search Console. Sin él, app/layout.tsx no emite la etiqueta.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# El ID del motor de Google Custom Search (el `cx`) que usa /buscar.
#
# Sin este valor la página /buscar responde 404 en vez de servir un buscador vacío: la página
# entera existe para ese widget, y una página que no hace nada es peor que una que no está.
NEXT_PUBLIC_GOOGLE_SEARCH_ENGINE_ID=
